{
	"layer": "top",
	"position": "top",
	"spacing": 0,

	"modules-left": [
		"hyprland/workspaces",
		"custom/media"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"pulseaudio",
		"battery",
		"network",
		"bluetooth"
	],

	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{name}",
		"sort-by-number": true
	},

	"custom/media": {
		"format": "  {}",
		"exec": "while true; do playerctl metadata --format '{{artist}} - {{title}}'; done",
		"return-type": "json"
	},

	"clock": {
		"format": "{:%H:%M}",
		"tooltip": false
	},

	"pulseaudio": {
		"format": "VOL {volume}%",
		"format-muted": "VOL X",
		"on-click": "pavucontrol"
	},

	"battery": {
		"states": {
			"warning": 25,
			"critical": 10
		},
		"format": "BAT {capacity}%",
		"tooltip": false
	},

	"network": {
		"format-wifi": "WIFI {essid}",
		"format-ethernet": "ETH",
		"format-disconnected": "404"
	},

	"bluetooth": {
		"format": "",
		"format-connected": "BT {device_alias}",
		"format-disabled": "BT OFF",
		"format-off": "BT OFF",
		"format-on": "BT ON"
	}
}
